.page {
  min-height: 100vh;
  background: #f6f7f3;
}

.intro {
  padding: 28rpx 32rpx 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.title {
  flex: 1;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -1rpx;
}

.favorite-button {
  flex: 0 0 auto;
  height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #cbd5d1;
  border-radius: 44rpx;
  color: #596561;
  background: #fff;
  font-size: 24rpx;
  line-height: 84rpx;
}

.favorite-button.is-active {
  border-color: #123b31;
  color: #fff;
  background: #123b31;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 9rpx 20rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 1;
}

.tag-primary {
  color: #fff;
  background: #123b31;
}

.tag-level {
  color: #123b31;
  background: #ddf66b;
}

.media-wrap {
  position: relative;
  height: 520rpx;
  margin: 0 24rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #18211f;
}

.media {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.poster {
  opacity: 0.78;
}

.gif {
  opacity: 0;
  transition: opacity 180ms ease;
}

.gif.is-visible {
  opacity: 1;
}

.media-status,
.media-error {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 12rpx 20rpx;
  border-radius: 34rpx;
  color: #fff;
  background: rgba(18, 59, 49, 0.86);
  box-sizing: border-box;
  font-size: 23rpx;
}

.media-error {
  justify-content: space-between;
}

.loading-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #ddf66b;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.retry-button {
  height: 52rpx;
  margin: 0 0 0 16rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 26rpx;
  color: #fff;
  background: transparent;
  font-size: 22rpx;
  line-height: 48rpx;
}

.content {
  padding: 24rpx 24rpx 20rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.info-card {
  min-height: 128rpx;
  padding: 22rpx;
  border: 2rpx solid #e2e7e4;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.info-card-wide {
  grid-column: 1 / -1;
  min-height: 0;
}

.info-label {
  margin-bottom: 14rpx;
  color: #7a8581;
  font-size: 22rpx;
}

.info-value {
  color: #123b31;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muscle-values {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.muscle-pill {
  color: #167555;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muscle-pill + .muscle-pill::before {
  margin-right: 10rpx;
  color: #a1aaa6;
  content: "·";
}

.muscle-pill-light {
  color: #596561;
  font-size: 25rpx;
  font-weight: 500;
}

.section {
  margin-top: 50rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 750;
}

.section-number {
  color: #178b66;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.warning-number {
  color: #a26615;
}

.step {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid #e2e7e4;
}

.step:last-child {
  border-bottom: 0;
}

.step-index {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  color: #fff;
  background: #25c48c;
  font-size: 22rpx;
  font-weight: 700;
}

.step-text {
  flex: 1;
  padding-top: 3rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.caution-card {
  padding: 8rpx 24rpx;
  border: 2rpx solid #efcb8b;
  border-radius: 24rpx;
  background: #fff5df;
}

.caution-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(162, 102, 21, 0.14);
}

.caution-item:last-child {
  border-bottom: 0;
}

.caution-icon {
  display: flex;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin: 4rpx 16rpx 0 0;
  border-radius: 50%;
  color: #fff;
  background: #a26615;
  font-size: 22rpx;
  font-weight: 800;
}

.caution-text {
  flex: 1;
  color: #744911;
  font-size: 27rpx;
  line-height: 1.65;
}

.disclaimer {
  margin-top: 46rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  color: #71807a;
  background: #e7ece8;
  font-size: 23rpx;
  line-height: 1.65;
}

.disclaimer-title {
  margin-bottom: 8rpx;
  color: #43524d;
  font-weight: 700;
}

.not-found {
  display: flex;
  min-height: 100vh;
  padding: 160rpx 48rpx 40rpx;
  align-items: center;
  flex-direction: column;
  box-sizing: border-box;
  text-align: center;
}

.not-found-code {
  color: #cbd5d1;
  font-size: 112rpx;
  font-weight: 800;
  line-height: 1;
}

.not-found-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.not-found-copy {
  margin-top: 14rpx;
  color: #7b8783;
  font-size: 26rpx;
}

.home-button {
  height: 84rpx;
  margin-top: 40rpx;
  padding: 0 40rpx;
  border-radius: 42rpx;
  color: #fff;
  background: #123b31;
  font-size: 28rpx;
  line-height: 84rpx;
}
