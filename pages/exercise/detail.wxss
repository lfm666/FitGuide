.page {
  min-height: 100vh;
}

.media-wrap {
  position: relative;
  width: 100%;
  height: 610rpx;
  overflow: hidden;
  background: #18211f;
}

.media {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.poster {
  opacity: 0.78;
}

.gif {
  opacity: 0;
  transition: opacity 180ms ease;
}

.gif.is-visible {
  opacity: 1;
}

.media-status,
.media-error {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  color: #fff;
  background: rgba(23, 32, 30, 0.78);
  box-sizing: border-box;
  font-size: 23rpx;
}

.media-error {
  justify-content: space-between;
}

.loading-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #58c6aa;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.retry-button {
  height: 52rpx;
  margin: 0 0 0 16rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 26rpx;
  color: #fff;
  background: transparent;
  font-size: 22rpx;
  line-height: 48rpx;
}

.content {
  position: relative;
  z-index: 1;
  margin-top: -30rpx;
  padding: 38rpx 24rpx 20rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #f5f7f8;
}

.tag-row {
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  color: #596561;
  background: #e3e9e7;
  font-size: 22rpx;
  line-height: 1;
}

.tag-primary {
  color: #176c58;
  background: #d8eee8;
}

.title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.28;
}

.equipment {
  margin-top: 12rpx;
  color: #66736f;
  font-size: 27rpx;
}

.muscle-card {
  margin-top: 32rpx;
  padding: 26rpx;
  border: 2rpx solid #e5eae8;
  border-radius: 24rpx;
  background: #fff;
}

.muscle-item {
  display: flex;
  align-items: flex-start;
}

.muscle-secondary {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #eef1f0;
}

.muscle-label {
  flex: 0 0 130rpx;
  padding-top: 7rpx;
  color: #6e7a76;
  font-size: 24rpx;
}

.muscle-values {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx;
}

.muscle-pill {
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  color: #176c58;
  background: #dff1ec;
  font-size: 23rpx;
  line-height: 1;
}

.muscle-pill-light {
  color: #596561;
  background: #edf1ef;
}

.section {
  margin-top: 52rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-number {
  margin-right: 16rpx;
  color: #1f8a70;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.warning-number {
  color: #a44a00;
}

.section-title {
  font-size: 34rpx;
  font-weight: 750;
}

.step {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e5eae8;
}

.step:last-child {
  border-bottom: 0;
}

.step-index {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  color: #fff;
  background: #1f8a70;
  font-size: 22rpx;
  font-weight: 700;
}

.step-text {
  flex: 1;
  padding-top: 4rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.caution-card {
  padding: 8rpx 24rpx;
  border: 2rpx solid #f1d6b7;
  border-radius: 24rpx;
  background: #fff3e0;
}

.caution-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(164, 74, 0, 0.12);
}

.caution-item:last-child {
  border-bottom: 0;
}

.caution-icon {
  display: flex;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin: 4rpx 16rpx 0 0;
  border-radius: 50%;
  color: #fff;
  background: #a44a00;
  font-size: 22rpx;
  font-weight: 800;
}

.caution-text {
  flex: 1;
  color: #793a08;
  font-size: 27rpx;
  line-height: 1.65;
}

.disclaimer {
  margin-top: 48rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  color: #74807c;
  background: #e9eeec;
  font-size: 23rpx;
  line-height: 1.65;
}

.disclaimer-title {
  margin-bottom: 8rpx;
  color: #4c5955;
  font-weight: 700;
}

.not-found {
  display: flex;
  min-height: 100vh;
  padding: 160rpx 48rpx 40rpx;
  align-items: center;
  flex-direction: column;
  box-sizing: border-box;
  text-align: center;
}

.not-found-code {
  color: #cbd5d1;
  font-size: 112rpx;
  font-weight: 800;
  line-height: 1;
}

.not-found-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.not-found-copy {
  margin-top: 14rpx;
  color: #7b8783;
  font-size: 26rpx;
}

.home-button {
  height: 84rpx;
  margin-top: 40rpx;
  padding: 0 40rpx;
  border-radius: 42rpx;
  color: #fff;
  background: #1f8a70;
  font-size: 28rpx;
  line-height: 84rpx;
}
