<view class="page">
  <view class="hero">
    <view class="hero-ring hero-ring-large"></view>
    <view class="hero-ring hero-ring-small"></view>
    <view class="hero-content">
      <view class="eyebrow">FITGUIDE</view>
      <view class="title">今天，练得<text>更标准</text></view>
      <view class="subtitle">找到器械 · 看懂动作 · 安全完成</view>
    </view>
    <view class="hero-figure" aria-hidden="true">
      <view class="figure-head"></view>
      <view class="figure-body"></view>
      <view class="figure-bar"></view>
    </view>

    <view class="search-box">
      <text class="search-icon" aria-hidden="true">⌕</text>
      <input
        class="search-input"
        value="{{query}}"
        placeholder="搜索动作、器械或肌群"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
        aria-label="搜索动作、器械或肌群"
      />
    </view>
  </view>

  <view class="content safe-bottom">
    <scroll-view class="categories" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-row">
        <button
          wx:for="{{categories}}"
          wx:key="*this"
          class="category-button {{activeCategory === item ? 'is-active' : ''}}"
          data-category="{{item}}"
          bindtap="onCategoryTap"
          aria-label="筛选{{item}}动作"
        >{{item}}</button>
      </view>
    </scroll-view>

    <scroll-view class="categories equipment-categories" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-row">
        <button
          wx:for="{{equipments}}"
          wx:key="*this"
          class="category-button {{activeEquipment === item ? 'is-active' : ''}}"
          data-equipment="{{item}}"
          bindtap="onEquipmentTap"
          aria-label="筛选{{item}}动作"
        >{{item}}</button>
      </view>
    </scroll-view>

    <view class="result-bar">
      <text class="result-title">{{activeCategory === '全部' ? '推荐动作' : activeCategory + '动作'}}</text>
      <text class="result-count">{{exercises.length}} 个动作</text>
    </view>

    <view wx:if="{{exercises.length}}" class="exercise-list">
      <view
        wx:for="{{exercises}}"
        wx:key="id"
        wx:for-index="index"
        class="exercise-card"
        hover-class="card-pressed"
        data-id="{{item.id}}"
        bindtap="openExercise"
        role="button"
        aria-label="查看{{item.name}}动作详情"
      >
        <view class="cover-wrap">
          <image
            wx:if="{{!item.imageFailed}}"
            class="cover"
            src="{{item.image}}"
            mode="aspectFill"
            lazy-load
            data-index="{{index}}"
            binderror="onImageError"
          />
          <view wx:else class="cover-fallback">
            <text class="fallback-mark">FG</text>
            <text class="fallback-name">{{item.name}}</text>
          </view>
        </view>
        <view class="card-content">
          <view class="card-title-row">
            <view class="exercise-name">{{item.name}}</view>
            <text class="level-tag">{{item.level}}</text>
          </view>
          <view class="equipment">器械 · {{item.equipment}}</view>
          <view class="muscle-row">
            <text class="muscle-icon">◉</text>
            <text class="muscle-text">{{item.primaryMusclesText}}</text>
          </view>
        </view>
        <text class="card-arrow" aria-hidden="true">›</text>
      </view>
    </view>

    <view wx:else class="empty-state">
      <view class="empty-mark">?</view>
      <view class="empty-title">没有找到相关动作</view>
      <view class="empty-copy">换个关键词，或者清空当前筛选</view>
      <button class="reset-button" bindtap="clearFilters">清空筛选</button>
    </view>

    <view class="disclaimer">{{disclaimer}}</view>
  </view>
</view>
