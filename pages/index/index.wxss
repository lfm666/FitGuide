.page {
  min-height: 100vh;
  background: #f6f7f3;
}

.hero {
  position: relative;
  height: 440rpx;
  overflow: hidden;
  padding: 36rpx 40rpx 0;
  color: #fff;
  background: #123b31;
  box-sizing: border-box;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.eyebrow {
  color: #ddf66b;
  font-size: 28rpx;
  font-style: italic;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.title {
  width: 430rpx;
  margin-top: 34rpx;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: -2rpx;
}

.title text {
  display: block;
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hero-ring {
  position: absolute;
  border: 2rpx solid rgba(221, 246, 107, 0.14);
  border-radius: 50%;
}

.hero-ring-large {
  top: -170rpx;
  right: -190rpx;
  width: 560rpx;
  height: 560rpx;
}

.hero-ring-small {
  top: 80rpx;
  right: -20rpx;
  width: 270rpx;
  height: 270rpx;
}

.hero-figure {
  position: absolute;
  right: -10rpx;
  bottom: 58rpx;
  width: 260rpx;
  height: 280rpx;
  opacity: 0.92;
}

.figure-head {
  position: absolute;
  top: 56rpx;
  left: 100rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #d8a078;
}

.figure-body {
  position: absolute;
  top: 108rpx;
  left: 58rpx;
  width: 150rpx;
  height: 200rpx;
  border-radius: 74rpx 74rpx 12rpx 12rpx;
  background: #071c16;
  transform: rotate(-4deg);
}

.figure-bar {
  position: absolute;
  top: 28rpx;
  right: 0;
  left: 0;
  height: 10rpx;
  border-radius: 8rpx;
  background: #dce6e2;
  transform: rotate(-5deg);
}

.search-box {
  position: absolute;
  z-index: 4;
  right: 28rpx;
  bottom: 24rpx;
  left: 28rpx;
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 46rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.16);
}

.search-icon {
  margin-right: 16rpx;
  color: #123b31;
  font-size: 40rpx;
  line-height: 1;
  transform: rotate(-20deg);
}

.search-input {
  flex: 1;
  height: 92rpx;
  color: #17201e;
  font-size: 27rpx;
}

.search-placeholder {
  color: #89938f;
}

.content {
  padding: 0 24rpx;
}

.categories {
  width: calc(100% + 48rpx);
  margin: 0 -24rpx;
  padding-top: 26rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx 8rpx;
}

.equipment-categories {
  padding-top: 4rpx;
}

.category-button {
  min-width: 92rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 32rpx;
  color: #5f6965;
  background: #e9ece8;
  font-size: 25rpx;
  line-height: 64rpx;
}

.category-button.is-active {
  color: #fff;
  background: #123b31;
  font-weight: 600;
}

.result-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 34rpx 8rpx 20rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
}

.result-count {
  color: #7d8783;
  font-size: 24rpx;
}

.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.exercise-card {
  display: flex;
  align-items: center;
  min-height: 190rpx;
  padding: 16rpx;
  border: 2rpx solid #e2e7e4;
  border-radius: 28rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(18, 59, 49, 0.055);
  transition: transform 120ms ease;
}

.card-pressed {
  transform: scale(0.985);
}

.cover-wrap {
  position: relative;
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 158rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #dce7e2;
}

.cover {
  width: 100%;
  height: 100%;
}

.cover-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #45675d;
  text-align: center;
}

.fallback-mark {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.fallback-name {
  margin-top: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
  padding: 4rpx 18rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.exercise-name {
  flex: 1;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-tag {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 18rpx;
  color: #157555;
  background: #e0f5e9;
  font-size: 20rpx;
  line-height: 1;
}

.equipment {
  overflow: hidden;
  margin-top: 16rpx;
  color: #717c78;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.muscle-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 14rpx;
  color: #178b66;
  font-size: 22rpx;
}

.muscle-icon {
  flex: 0 0 auto;
  margin-right: 8rpx;
  font-size: 16rpx;
}

.muscle-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-arrow {
  flex: 0 0 auto;
  color: #7d8783;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 32rpx 80rpx;
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  color: #123b31;
  background: #ddf66b;
  font-size: 52rpx;
  font-weight: 700;
}

.empty-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 12rpx;
  color: #7b8783;
  font-size: 25rpx;
}

.reset-button {
  height: 80rpx;
  margin-top: 32rpx;
  padding: 0 38rpx;
  border-radius: 40rpx;
  color: #fff;
  background: #123b31;
  font-size: 27rpx;
  line-height: 80rpx;
}

.disclaimer {
  padding: 48rpx 20rpx 12rpx;
  color: #8b9692;
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}
