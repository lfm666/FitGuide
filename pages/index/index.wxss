.page {
  padding: 0 24rpx;
}

.hero {
  padding: 52rpx 8rpx 28rpx;
}

.eyebrow {
  color: #1f8a70;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.title {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  margin-top: 12rpx;
  color: #66736f;
  font-size: 27rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e7ecea;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(23, 32, 30, 0.05);
}

.search-icon {
  margin-right: 18rpx;
  color: #1f8a70;
  font-size: 44rpx;
  line-height: 1;
  transform: rotate(-20deg);
}

.search-input {
  flex: 1;
  height: 92rpx;
  font-size: 29rpx;
}

.search-placeholder {
  color: #97a39f;
}

.categories {
  width: calc(100% + 48rpx);
  margin: 28rpx -24rpx 0;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 24rpx 8rpx;
}

.category-button {
  min-width: 104rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 34rpx;
  color: #596561;
  background: #e9eeec;
  font-size: 26rpx;
  line-height: 68rpx;
}

.category-button.is-active {
  color: #fff;
  background: #1f8a70;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(31, 138, 112, 0.22);
}

.result-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 34rpx 8rpx 20rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
}

.result-count {
  color: #7b8783;
  font-size: 24rpx;
}

.exercise-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.exercise-card {
  overflow: hidden;
  border: 2rpx solid #e8edeb;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 30, 0.045);
  transition: transform 120ms ease;
}

.card-pressed {
  transform: scale(0.98);
}

.cover-wrap {
  position: relative;
  height: 260rpx;
  overflow: hidden;
  background: #e8eeeb;
}

.cover {
  width: 100%;
  height: 100%;
}

.cover-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #587069;
  text-align: center;
}

.fallback-mark {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.fallback-name {
  margin-top: 8rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
}

.level-tag {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  padding: 7rpx 14rpx;
  border-radius: 18rpx;
  color: #fff;
  background: rgba(23, 32, 30, 0.72);
  font-size: 20rpx;
  line-height: 1;
}

.card-content {
  padding: 20rpx 20rpx 22rpx;
}

.exercise-name {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.equipment {
  overflow: hidden;
  margin-top: 8rpx;
  color: #6c7874;
  font-size: 23rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.muscle-row {
  display: flex;
  align-items: center;
  overflow: hidden;
  margin-top: 14rpx;
  color: #1f8a70;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #1f8a70;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 32rpx 80rpx;
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  color: #1f8a70;
  background: #e1f1ec;
  font-size: 52rpx;
  font-weight: 700;
}

.empty-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 12rpx;
  color: #7b8783;
  font-size: 25rpx;
}

.reset-button {
  height: 80rpx;
  margin-top: 32rpx;
  padding: 0 38rpx;
  border-radius: 40rpx;
  color: #fff;
  background: #1f8a70;
  font-size: 27rpx;
  line-height: 80rpx;
}

.disclaimer {
  padding: 48rpx 20rpx 12rpx;
  color: #8b9692;
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}
