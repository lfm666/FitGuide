.edit-page {
  min-height: 100vh;
}

.edit-header {
  padding: 44rpx 32rpx 36rpx;
  color: #fff;
  background: #123b31;
}

.eyebrow {
  color: #c7f24a;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.edit-title {
  margin: 12rpx 0 30rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.field-label {
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.name-input,
.selector-search {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  color: #17201e;
  background: #fff;
}

.edit-content {
  padding: 32rpx;
}

.section-heading,
.selector-header,
.selector-footer,
.set-row,
.item-actions {
  display: flex;
  align-items: center;
}

.section-heading,
.selector-header {
  justify-content: space-between;
}

.section-title,
.selector-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-copy {
  margin-top: 6rpx;
  color: #7d8783;
  font-size: 23rpx;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.item-card {
  display: flex;
  gap: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #e1e7e2;
  border-radius: 22rpx;
  background: #fff;
}

.missing-item {
  border-color: #e7c9a7;
  background: #fffaf3;
}

.item-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #123b31;
  background: #dff3e8;
  font-weight: 700;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
}

.item-equipment {
  margin-top: 8rpx;
  color: #75807c;
  font-size: 23rpx;
}

.set-row {
  gap: 14rpx;
  margin-top: 22rpx;
}

button {
  margin: 0;
  font-size: 26rpx;
}

.round-button,
.close-button {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 50%;
  color: #123b31;
  background: #edf2ef;
  line-height: 64rpx;
}

.set-input {
  width: 90rpx;
  height: 64rpx;
  border: 1rpx solid #dce3de;
  border-radius: 12rpx;
  text-align: center;
}

.set-unit {
  color: #66716d;
}

.item-actions {
  gap: 12rpx;
  margin-top: 18rpx;
}

.text-button {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  color: #52605b;
  background: #f3f5f3;
  font-size: 23rpx;
  line-height: 56rpx;
}

.danger-text {
  color: #b83737;
}

.primary-button,
.secondary-button,
.save-button {
  min-height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  line-height: 72rpx;
}

.primary-button,
.save-button {
  color: #123b31;
  background: #c7f24a;
  font-weight: 700;
}

.secondary-button {
  background: #edf2ef;
}

.compact-button {
  flex: none;
}

.save-button {
  width: 100%;
  margin-top: 32rpx;
}

.inline-empty,
.selector-empty {
  margin-top: 24rpx;
  padding: 60rpx 24rpx;
  border: 2rpx dashed #d8dfda;
  border-radius: 20rpx;
  color: #7d8783;
  text-align: center;
}

.selector-mask {
  position: fixed;
  z-index: 10;
  inset: 0;
  background: rgba(0, 0, 0, 0.48);
}

.selector-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 92vh;
  padding: 30rpx 28rpx 0;
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.selector-search {
  margin-top: 24rpx;
  border: 1rpx solid #dbe2dd;
  background: #f7f9f7;
}

.filter-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-button {
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 29rpx;
  color: #5e6b66;
  background: #f0f3f1;
  line-height: 58rpx;
}

.filter-button.active {
  color: #fff;
  background: #17a673;
}

.selector-list {
  height: 52vh;
  margin-top: 18rpx;
}

.selector-item {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #edf0ed;
  border-radius: 0;
  text-align: left;
  background: #fff;
  line-height: 1.4;
}

.selector-item.checked {
  background: #f2faea;
}

.check-mark {
  width: 60rpx;
  color: #17a673;
  font-size: 34rpx;
  text-align: center;
}

.selector-item-copy {
  min-width: 0;
  flex: 1;
}

.selector-item-name {
  font-weight: 700;
}

.selector-item-meta {
  margin-top: 6rpx;
  color: #7d8783;
  font-size: 22rpx;
}

.selector-footer {
  justify-content: flex-end;
  gap: 18rpx;
  padding: 24rpx 0;
  background: #fff;
}

.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-copy {
  margin: 14rpx 0 28rpx;
  color: #7d8783;
}
